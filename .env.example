# Active local profile.
SPRING_PROFILES_ACTIVE=whatever-you-want-depending-on-the-profile

# Docker compose dev defaults. Override these in shared/prod environments.
REPORTING_POSTGRES_DB=aries_reporting_db
REPORTING_POSTGRES_USER=reporting_user
REPORTING_POSTGRES_PASSWORD=change_me_for_local_only

# Read-only transaction DB credentials. Must match the transfer service database.
TRANSACTION_DB_USERNAME=transfer_user
TRANSACTION_DB_PASSWORD=change_me_to_match_transfer_db

# Spring datasource values used by the dev profile.
SPRING_DATASOURCE_REPORTING_URL=jdbc:postgresql://localhost:5433/aries_reporting_db
SPRING_DATASOURCE_REPORTING_USERNAME=reporting_user
SPRING_DATASOURCE_REPORTING_PASSWORD=change_me_for_local_only
SPRING_DATASOURCE_TRANSACTION_URL=jdbc:postgresql://localhost:5432/aries_transaction_db
SPRING_DATASOURCE_TRANSACTION_USERNAME=transfer_user
SPRING_DATASOURCE_TRANSACTION_PASSWORD=change_me_to_match_transfer_db

# Local Redis.
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# JWT must match the transfer system issuer.
JWT_SECRET=replace_with_same_secret_as_transfer_system
JWT_ISSUER=aries-transaction
JWT_AUDIENCE=aries-transaction-api
JWT_TOKEN_TYPE=access
JWT_CLOCK_SKEW_SECONDS=30

# Generic SMTP settings. Headers do not provide dedupe by themselves;
# exactly-once requires a provider idempotency API or explicit provider support.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@aries.local
# SMTP network timeouts (milliseconds)
MAIL_SMTP_CONNECTION_TIMEOUT_MS=10000
MAIL_SMTP_READ_TIMEOUT_MS=30000
MAIL_SMTP_WRITE_TIMEOUT_MS=30000

# Local reporting behavior.
EXPORT_DIR=./exports
EXPORT_TTL_HOURS=24
CACHE_TTL_MINUTES=10
PUBLIC_BASE_URL=http://localhost:3000
SERVER_PORT=8081

# Monthly email delivery tuning. Values are validated at startup.
EMAIL_ACTIVE_USER_PAGE_SIZE=100
EMAIL_DISPATCH_BATCH_SIZE=20
EMAIL_WORKER_COUNT=2
EMAIL_QUEUE_CAPACITY=20
EMAIL_DISPATCH_DELAY_MS=1000
EMAIL_LEASE_DURATION=PT5M
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_DELAY=PT30S
EMAIL_RETRY_MAX_DELAY=PT1H
EMAIL_RATE_LIMIT_RETRY_DELAY=PT0.25S
# Provisional default; tune from measured MQ projection p99 + recovery margin.
EMAIL_EMPTY_STATEMENT_GRACE_PERIOD=PT6H
EMAIL_PERMITS_PER_SECOND=10
EMAIL_BURST_CAPACITY=10
EMAIL_RATE_LIMIT_KEY=aries:email:rate:smtp
